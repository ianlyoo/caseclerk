# Sandbox only. Values come from the key store / Vercel env; never commit real values.
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# ID of the webhook registered for this deployment (scripts/register-webhook.mjs prints it)
PAYPAL_WEBHOOK_ID=
# Sandbox accounts (emails, not secrets) used by spike scripts
PAYPAL_SANDBOX_BUYER_EMAIL=
PAYPAL_SANDBOX_SELLER_EMAIL=
# Buyer's sandbox payer ID (for the create-dispute simulator's PayPal-Auth-Assertion)
PAYPAL_SANDBOX_BUYER_PAYER_ID=
# Seller merchant id for the process-chargeback simulator (fallback; the order response usually has it)
PAYPAL_MERCHANT_ID=
# Set to 1 to run tests/paypal/live.test.ts against the sandbox (scripts/test-live.sh does this)
PAYPAL_LIVE_TESTS=
# Later stages
DATABASE_URL=
PAYPAL_CONSENT_REDIRECT_URI=
