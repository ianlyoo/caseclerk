# CaseClerk environment. Names only: put values in .env.local (gitignored) or your host's env settings.
# Sandbox only: src/lib/paypal/client.ts refuses any PayPal base that isn't *.sandbox.paypal.com.

# --- PayPal (app runtime) ---
# PayPal REST base URL; defaults to https://api-m.sandbox.paypal.com when unset
PAYPAL_API_BASE=
# Sandbox REST app client id (developer.paypal.com > Apps & Credentials)
PAYPAL_CLIENT_ID=
# Sandbox REST app secret (secret: never commit)
PAYPAL_CLIENT_SECRET=
# Id of the webhook registered for this deployment's /api/webhooks/paypal (scripts/webhooks.ts create prints it)
PAYPAL_WEBHOOK_ID=
# Seller merchant id for the process-chargeback simulator (fallback; the order response usually carries it)
PAYPAL_MERCHANT_ID=
# Sandbox buyer email, used in the PayPal-Auth-Assertion of the inquiry simulator (createInquiry) and the spike scripts
PAYPAL_SANDBOX_BUYER_EMAIL=
# Return URL for the buyer's Log in with PayPal consent (inquiry disputes only); defaults to <this host>/api/paypal/consent-callback
PAYPAL_CONSENT_REDIRECT_URI=
# Set to 1 to give the agent the search_transactions tool (needs Transaction Search enabled on the PayPal app)
PAYPAL_TRANSACTION_SEARCH=

# --- Claude ---
# Anthropic API key, read by @anthropic-ai/sdk (secret: never commit)
ANTHROPIC_API_KEY=

# --- Database ---
# Neon Postgres connection string (pooled); unset = in-memory store, lost on restart
DATABASE_URL=
# Direct (unpooled) Neon connection, preferred by the migration script (src/lib/db/migrate.ts) when set
DATABASE_URL_UNPOOLED=

# --- UI ---
# Origin the pages read the API from (server side, GET only); defaults to https://caseclerk.vercel.app, so set http://localhost:3000 locally
CASECLERK_API_ORIGIN=

# --- Caps (optional; defaults in brackets) ---
# All-time Claude spend cap in USD [45]
SPEND_CAP_TOTAL_USD=
# Daily Claude spend cap in USD [4]
SPEND_CAP_DAILY_USD=
# Agent runs per day across all cases [60]
AGENT_RUNS_PER_DAY=
# Test disputes one visitor IP may open per day [3]
TEST_DISPUTES_PER_IP_PER_DAY=
# Test disputes per day across all visitors [40]
TEST_DISPUTES_PER_DAY=
# Sandbox simulator calls (require-evidence, adjudicate) per IP per hour via /api/cases/:id/simulate [20]
SIMULATE_PER_IP_PER_HOUR=
# Simulator availability checks per IP per hour [120]
SIMULATE_CHECKS_PER_IP_PER_HOUR=

# --- Daily test-dispute cron (vercel.json, /api/cron/test-dispute) ---
# Bearer secret Vercel Cron sends; the route answers 503 without it (secret: never commit)
CRON_SECRET=
# Set to 1 to let the cron open a test dispute; anything else skips it
CRON_TEST_DISPUTE=
# Test disputes the cron may open per day [1]
CRON_TEST_DISPUTES_PER_DAY=

# --- Scripts, eval and tests (not read by the app) ---
# Path of the env file scripts/run.sh and scripts/test-live.sh load before running
CASECLERK_ENV=
# Seller merchant id for eval/open-dispute.ts
PAYPAL_SANDBOX_MERCHANT_ID=
# Set to 1 to run tests/paypal/live.test.ts against the sandbox (scripts/test-live.sh sets it)
PAYPAL_LIVE_TESTS=
# Dispute id (WAITING_FOR_SELLER_RESPONSE) for the live provideEvidence test
PAYPAL_LIVE_EVIDENCE_DISPUTE=
# File path where scripts/spike/*.mjs append their run log
SPIKE_RUN_LOG=

# Set by Vercel, not by you: VERCEL_ENV, VERCEL_GIT_COMMIT_SHA (shown by /api/health)
